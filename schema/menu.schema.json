{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jellyfin-disc-menus/menu.schema.json",
  "title": "Disc Menu Definition (shareable)",
  "description": "Portable menu definition. Anchored to a Jellyfin-matched parent item via provider IDs. Contains NO file names, paths, or local Jellyfin item IDs; those live in the separate binding file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "menuId", "revision", "match", "extras", "menus", "root"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "menuId": {
      "description": "Stable UUID for this menu across revisions. Bindings reference it.",
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "description": "Monotonic revision number. Bump on any change to extras or menus.",
      "type": "integer",
      "minimum": 1
    },
    "meta": { "$ref": "#/$defs/meta" },
    "match": { "$ref": "#/$defs/match" },
    "background": { "$ref": "#/$defs/background" },
    "theme": { "$ref": "#/$defs/theme" },
    "extras": {
      "description": "Extras this release is expected to contain, keyed by a menu-local key. Entries reference these keys; each is resolved once to a local item in the binding file.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/extraSpec" },
      "minProperties": 0
    },
    "root": {
      "description": "Key of the menu shown first.",
      "$ref": "#/$defs/key"
    },
    "menus": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/menu" },
      "minProperties": 1
    }
  },

  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "label": {
      "description": "Plain text only. Renderers MUST insert as text (textContent), never as HTML.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^<>]*$"
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "maxLength": 64 },
        "created": { "type": "string", "format": "date-time" },
        "updated": { "type": "string", "format": "date-time" },
        "language": {
          "description": "BCP 47 language tag of the labels.",
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "notes": { "type": "string", "maxLength": 500 }
      }
    },

    "match": {
      "description": "Identifies the parent item via Jellyfin's metadata match, not files. At least one provider ID is required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["itemType", "providerIds"],
      "properties": {
        "itemType": { "enum": ["Movie", "Series", "Season"] },
        "providerIds": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "Tmdb": { "type": "string", "pattern": "^[0-9]+$" },
            "Imdb": { "type": "string", "pattern": "^tt[0-9]{7,9}$" },
            "Tvdb": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "seasonNumber": {
          "description": "Required when itemType is Season.",
          "type": "integer",
          "minimum": 0
        },
        "release": {
          "description": "Which physical release this menu describes. Extras differ between editions, so this disambiguates multiple menus for the same title.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "edition": { "type": "string", "maxLength": 80 },
            "format": { "enum": ["DVD", "BluRay", "UHD", "Digital", "Other"] },
            "region": { "type": "string", "maxLength": 16 },
            "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
            "publisher": { "type": "string", "maxLength": 80 },
            "upc": { "type": "string", "pattern": "^[0-9]{8,14}$" }
          }
        }
      },
      "if": { "properties": { "itemType": { "const": "Season" } } },
      "then": { "required": ["seasonNumber"] }
    },

    "background": {
      "description": "Image references only; images are fetched locally at render time and never stored in the shared file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["jellyfin", "tmdb", "fanart", "color"] },
        "imageType": {
          "description": "For source=jellyfin: which of the parent item's images to use.",
          "enum": ["Primary", "Art", "Backdrop", "Banner", "Logo", "Thumb", "Disc", "Box", "Screenshot", "Menu", "BoxRear"]
        },
        "index": {
          "description": "Image index for multi-image types (e.g. backdrop #2).",
          "type": "integer",
          "minimum": 0
        },
        "tmdbFilePath": {
          "description": "For source=tmdb: the TMDB file_path, e.g. /abc123.jpg.",
          "type": "string",
          "pattern": "^/[A-Za-z0-9_-]+\\.(jpg|png|svg)$"
        },
        "fanartId": {
          "description": "For source=fanart: fanart.tv image id.",
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "color": {
          "description": "For source=color, or as a fallback tint.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dim": {
          "description": "Overlay darkening, 0 to 1, for label legibility.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "tmdb" } } }, "then": { "required": ["tmdbFilePath"] } },
        { "if": { "properties": { "source": { "const": "fanart" } } }, "then": { "required": ["fanartId"] } },
        { "if": { "properties": { "source": { "const": "color" } } }, "then": { "required": ["color"] } },
        { "if": { "properties": { "source": { "const": "jellyfin" } } }, "then": { "required": ["imageType"] } }
      ]
    },

    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "description": "Built-in theme/layout name shipped with the renderer. Unknown ids fall back to the default.",
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "align": { "enum": ["left", "center", "right"] }
      }
    },

    "extraSpec": {
      "description": "Properties used to match an expected extra to one of the parent item's local Special Features. Deliberately excludes file names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "durationSec"],
      "properties": {
        "type": {
          "description": "Jellyfin ExtraType (MediaBrowser.Model.Entities.ExtraType; verified against master for Jellyfin 12).",
          "enum": ["Clip", "Trailer", "BehindTheScenes", "DeletedScene", "Interview", "Scene", "Sample", "ThemeSong", "ThemeVideo", "Featurette", "Short", "Unknown"]
        },
        "durationSec": {
          "description": "Reference runtime in seconds. Primary matching signal.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "toleranceSec": {
          "description": "Allowed +/- deviation. Default is renderer-defined (suggest 3s).",
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "ordinal": {
          "description": "1-based position among extras of the same type, sorted by duration. Tiebreaker only.",
          "type": "integer",
          "minimum": 1
        },
        "optional": {
          "description": "If true, a missing local match does not flag the menu as incomplete.",
          "type": "boolean"
        }
      }
    },

    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "entries"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "background": { "$ref": "#/$defs/background" },
        "theme": { "$ref": "#/$defs/theme" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },

    "entry": {
      "type": "object",
      "required": ["action", "label"],
      "properties": {
        "action": { "enum": ["playFeature", "playExtra", "playSequence", "submenu", "chapters", "back"] },
        "label": { "$ref": "#/$defs/label" }
      },
      "oneOf": [
        {
          "title": "Play the main feature, optionally from a chapter",
          "additionalProperties": false,
          "properties": {
            "action": { "const": "playFeature" },
            "label": true,
            "startChapter": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "title": "Play one extra",
          "additionalProperties": false,
          "required": ["extra"],
          "properties": {
            "action": { "const": "playExtra" },
            "label": true,
            "extra": { "$ref": "#/$defs/key" }
          }
        },
        {
          "title": "Play several extras in order (a 'Play All')",
          "additionalProperties": false,
          "required": ["extras"],
          "properties": {
            "action": { "const": "playSequence" },
            "label": true,
            "extras": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/key" }
            }
          }
        },
        {
          "title": "Open another menu",
          "additionalProperties": false,
          "required": ["menu"],
          "properties": {
            "action": { "const": "submenu" },
            "label": true,
            "menu": { "$ref": "#/$defs/key" }
          }
        },
        {
          "title": "Scene selection generated from the feature's chapters",
          "additionalProperties": false,
          "properties": {
            "action": { "const": "chapters" },
            "label": true,
            "perPage": { "type": "integer", "minimum": 1, "maximum": 24 }
          }
        },
        {
          "title": "Return to the previous menu",
          "additionalProperties": false,
          "properties": {
            "action": { "const": "back" },
            "label": true
          }
        }
      ]
    }
  }
}
