{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "validate schemas",
      "type": "shell",
      "command": "docker compose run --rm validate",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dotnet build",
      "type": "shell",
      "command": "docker compose exec dev dotnet build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
