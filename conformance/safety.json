    {"kind":"image","value":"data:image/jpeg;base64,/9j/4AAQ","accepted":true},
    {"kind":"image","value":"data:image/webp;base64,UklGRg==","accepted":true},
    {"kind":"image","value":"data:image/svg+xml;base64,PHN2Zz4=","accepted":false},
    {"kind":"image","value":"data:image/gif;base64,R0lGOD","accepted":false},
    {"kind":"image","value":"data:text/html;base64,PGI+","accepted":false},
    {"kind":"image","value":"asset:menu/bg.webp","accepted":true},
    {"kind":"image","value":"asset:a","accepted":true},
